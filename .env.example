# ==============================================================================
# AI-Powered Content Management Platform — Environment Configuration Template
# Copy this file to .env and configure values before starting containers
# ==============================================================================

# Database Configuration (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=content_manager_db
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_password_replace_in_prod

# Cache & In-Memory Store (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TYPE=redis

# Application Ports
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=80

# Security & JWT Tokens
# Generate a secure 256-bit Base64-encoded secret key in production: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173

# AI Intelligence Provider Settings
# Options: mock, openai, gemini
AI_PROVIDER=mock
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Media Upload Storage
MEDIA_UPLOAD_DIR=/app/uploads
